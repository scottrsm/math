Cell[BoxData[
 RowBox[{
  RowBox[{"pwldistfunc", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"t", " ", "<", "2"}], ",", " ", 
      RowBox[{"30", "t"}], ",", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "<", "4"}], ",", " ", 
        RowBox[{"60", " ", "+", " ", 
         RowBox[{"60", " ", 
          RowBox[{"(", 
           RowBox[{"t", "-", "2"}], ")"}]}]}], ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"t", " ", "<", " ", "6"}], ",", 
          RowBox[{"180", " ", "+", "  ", 
           RowBox[{"40", 
            RowBox[{"(", 
             RowBox[{"t", "-", "4"}], ")"}]}]}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"t", " ", "<", " ", "8"}], ",", " ", 
            RowBox[{"260", " ", "+", " ", 
             RowBox[{"80", 
              RowBox[{"(", " ", 
               RowBox[{"t", "-", "6"}], ")"}]}]}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"t", "<", "10"}], ",", " ", "420"}], "]"}]}], "]"}]}], 
         "]"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input"],

