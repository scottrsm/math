   RowBox[{"Cos", "[", 
    RowBox[{"0.00942477796076938`", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x0", "2"], "+", 
       SuperscriptBox["y0", "2"]}], ")"}]}], "]"}]}], "+", 
  RowBox[{"0.01884955592153876`", " ", 
