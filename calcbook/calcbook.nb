 RowBox[{"<<", "\"\<VectorAnalysis`\>\""}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"linFunc", "[", 
   RowBox[{"x_", ",", "y_", ",", " ", "x0_", ",", "y0_"}], "]"}], " ", "=", 
  " ", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"Pi", " ", "0.003", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x0", "^", "2"}], " ", "+", " ", 
       RowBox[{"y0", "^", "2"}]}], ")"}]}], "]"}], "+", " ", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"Pi", " ", "0.003", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], " ", "+", " ", 
              RowBox[{"y", "^", "2"}]}], ")"}]}], "]"}], ",", " ", 
          RowBox[{"Cartesian", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}], " ", ",", 
        RowBox[{"-", "1"}]}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "\[Rule]", "x0"}], ",", 
        RowBox[{"y", "\[Rule]", "y0"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", "-", " ", "x0"}], ",", 
       RowBox[{"y", " ", "-", " ", "y0"}]}], "}"}]}], "]"}]}]}]], "Input"],

