Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"makeBars", "[", 
    RowBox[{"n_", ",", "dx_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ddx", "=", "dx"}], ",", " ", 
       RowBox[{"nn", " ", "=", " ", "n"}], ",", " ", 
       RowBox[{"result", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<", "nn"}], ",", 
        RowBox[{"i", "++"}], ",", " ", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"result", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", " ", "*", " ", "ddx"}], ",", "0"}], "}"}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", " ", "*", " ", "ddx"}], ",", " ", 
               RowBox[{"asym", "[", 
                RowBox[{"i", " ", "*", " ", "ddx"}], "]"}]}], "}"}]}], "}"}], 
           "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "result"}]}], 
    "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"makeCaps", "[", 
    RowBox[{"n_", ",", "dx_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ddx", " ", "=", " ", "dx"}], ",", " ", 
       RowBox[{"nn", " ", "=", " ", "n"}], ",", " ", 
       RowBox[{"result", " ", "=", " ", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<", "nn"}], ",", 
        RowBox[{"i", "++"}], ",", " ", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"result", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", " ", "-", "1"}], ")"}], " ", "ddx"}], ",", " ", 
               RowBox[{"asym", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], "ddx"}], "]"}]}], "}"}], 
             ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "  ", "ddx"}], ",", " ", 
               RowBox[{"asym", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], " ", "ddx"}], "]"}]}], 
              "}"}]}], "}"}], "]"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "result"}]}], "]"}], " "}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"approxg", " ", "=", " ", 
  RowBox[{"Show", "[", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.015", ",", " ", "0.015"}], "}"}], "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"RGBColor", "[", 
