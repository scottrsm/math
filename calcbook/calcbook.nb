Cell[BoxData[
 RowBox[{"appderivg", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{"1.`", ",", "0.`"}], "}"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0.25`", ",", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"0.25`", " ", "2"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"0.25`", "\[InvisibleSpace]", "-", "2.`"}], ")"}], 
               " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"0.25`", " ", "2"}], "]"}], " ", "0.25`"}]}]}], "}"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"5.`", ",", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"0.25`", " ", "2"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"5", "-", "2.`"}], ")"}], " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"0.25`", " ", "2"}], "]"}], " ", "0.25`"}]}]}], 
            "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{"0.015`", ",", "0.015`"}], "}"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
